# ── Mode ──────────────────────────────────────────────────────────────────────
# fixture = deterministic rehearsal (default). live = real Tachi signet/regtest I/O.
APP_MODE=fixture
PROOF_MODE=fixture
# Master switch for live writes. Live credit transitions additionally require
# KILL_SWITCH=false and (for mainnet) ALLOW_MAINNET=true.
LIVE_TACHI_ENABLED=false
# Emergency stop: while true, LiveTachiAdapter refuses ALL broadcasts.
# Set to false deliberately to arm live writes.
KILL_SWITCH=true
# Mainnet is refused at boot unless this is true AND live writes are armed AND the kill
# switch is off. Leaving it false also stops a misconfigured TACHI_NETWORK=mainnet from
# ever reaching a real chain; there is no other guard against it.
ALLOW_MAINNET=false

# ── Tachi / Taurus network ────────────────────────────────────────────────────
TACHI_NETWORK=signet
# Defaults per network: https://rpc-signet.tachibtc.com / https://rpc-regtest.tachibtc.com
TACHI_BASE_URL=
TACHI_RPC_URL=
TACHI_API_KEY=
TACHI_CLI_PATH=
# Real funded TAURUS P2TR vault the operator controls (live mode only).
TACHI_VAULT_REF=
# Comma-separated allowlist; live connect/reads/writes refuse anything else.
ALLOWED_VAULT_REFS=
# CometBFT chain id the live daemon MUST advertise (/tachi_nodeInfo). Empty =
# derive from TACHI_NETWORK: signet -> tachi-signet-1, regtest -> tachi-regtest-1.
# Attestation cannot be turned off except by the explicit opt-out below; a daemon
# that advertises nothing is refused, and only loopback hosts are trusted without it.
TACHI_EXPECTED_CHAIN_ID=
# Refuse live reads/writes unless the daemon attests that chain id. Turning this off
# is how a mainnet daemon gets used as a testnet one: the addresses look wrong but
# nothing else complains. Only loopback daemons may omit the field.
LIVE_REQUIRE_CHAIN_ATTESTATION=true
# When true (default) a failed collateral read refuses the decision instead of
# falling back to modeled/fixture collateral. Turning it off makes live mode lie
# about what the vault holds; keep it on.
LIVE_REQUIRE_CHAIN_READ=true
LIVE_ATTESTATION_TTL_MS=60000
LIVE_REQUEST_TIMEOUT_MS=20000
# How long a broadcast is waited on for block inclusion before it is reported as
# pending (the tx hash is journaled on the transition either way).
LIVE_CONFIRM_TIMEOUT_MS=45000
LIVE_POLL_INTERVAL_MS=1500
# Refuse to broadcast a transaction whose decoded fee exceeds this.
LIVE_MAX_FEE_SATS=5000
# Set to "true" to log (redacted) broadcast attempts.
DEBUG_TACHI=false

# ── Proof / oracle trust ──────────────────────────────────────────────────────
# Optional external HAT/RIP oracle (reference implementation: `corepack pnpm oracle`,
# scripts/hat-oracle.ts). DrawBound POSTs {vaultRef,positionId,debtUnits} to
# <HAT_ORACLE_URL>/v1/attestations/health and expects a signed proof back.
HAT_ORACLE_URL=
# STRICT MODE: comma-separated x-only hex pubkeys. When non-empty, health proofs
# MUST carry a valid BIP-340 Schnorr signature from one of these keys; unsigned
# server-derived attestations are rejected on connect AND on every draw.
PROOF_RELAY_PUBLIC_KEYS=
PROOF_MAX_AGE_SECONDS=300
MIN_HEALTH_BPS=12500

# ── Vault ownership proof ─────────────────────────────────────────────────────
# When true, connecting a P2TR vault address requires a valid BIP-322 ownership
# proof (single-use challenge from /api/wallet/challenge signed by the vault
# user key; see scripts/operator-live.mts). Fixture-style refs stay exempt.
REQUIRE_OWNERSHIP_PROOF=false

# ── Risk model ────────────────────────────────────────────────────────────────
MAX_TEST_SATS=5000
MAX_DRAWS_PER_POSITION=3
# Collateral sats backing one credit unit (credit limit = collateral / this).
CREDIT_UNIT_SATS=10

# ── Auth & sessions ───────────────────────────────────────────────────────────
# Browser sessions live this long before reconnect is required.
SESSION_TTL_MINUTES=720
# Required for destructive routes (POST /api/reset) and live-mode position seeding.
# If unset, reset is only available in fixture mode. Generate: openssl rand -hex 32
ADMIN_TOKEN=
# Escape hatch for a local demo: allows POST /api/reset with NO token at all. Never
# set this on a host anyone else can reach — it deletes every position and receipt.
ALLOW_INSECURE_RESET=false

# ── Rate limiting (per client IP, in-memory) ─────────────────────────────────
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
# How many trusted reverse-proxy hops to strip from X-Forwarded-For before taking the
# client IP. 0 (default) ignores the header entirely: safe, but every client behind
# that proxy shares one rate-limit bucket. Set it to your proxy's hop count only if
# the proxy actually rewrites the header.
TRUSTED_PROXY_HOPS=0

# ── Storage & logging ─────────────────────────────────────────────────────────
# json (default, single file, single instance) or sqlite (node:sqlite, durable,
# auto-imports an existing drawbound.json on first open).
DB_BACKEND=json
# Data directory for the store; mount a volume here in Docker.
DATA_DIR=.data
LOG_LEVEL=info

# ── Dev server (dev only; ignored in production) ─────────────────────────────
# Comma-separated origins that may load /_next/hmr in dev (LAN/tunnel/etc).
# Localhost and 127.0.0.1 are always allowed.
ALLOWED_DEV_ORIGINS=
